# DevSweep AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# NEBIUS TOKEN FACTORY + NVIDIA NEMOTRON
# ============================================
# Required for AI features (cleanup planning, project analysis, restore guidance)
# Get your API key from: https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nemotron-3-ultra

# ============================================
# WORKSPACE CONFIGURATION
# ============================================
# Root directory to scan for projects (default: current working directory)
DEVSWEEP_WORKSPACE_ROOT=

# Demo mode - uses deterministic fixture instead of real workspace
DEVSWEEP_DEMO_MODE=false

# ============================================
# STORAGE & DATABASE
# ============================================
# SQLite database path for project manifests and history
DEVSWEEP_DB_PATH=./data/devsweep.db

# ============================================
# SAFETY SETTINGS
# ============================================
# Default risk level for auto-approval (SAFE, CAUTION, DANGEROUS)
DEVSWEEP_DEFAULT_RISK_LEVEL=SAFE

# Maximum file size to scan (bytes, default: 100MB)
DEVSWEEP_MAX_FILE_SIZE=104857600

# ============================================
# SERVER CONFIGURATION
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO