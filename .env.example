# DevSweep AI - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# NEBIUS TOKEN FACTORY + NVIDIA NEMOTRON
# ============================================
# Required for AI features (cleanup planning, project analysis, restore guidance)
# Get your API key from: https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ============================================
# WORKSPACE CONFIGURATION
# ============================================
# Root directory to scan for projects (default: current working directory)
DEVSWEEP_WORKSPACE_ROOT=

# Demo mode is retained for local fixture identification; it does not replace real AI.
DEVSWEEP_DEMO_MODE=false
# Public hosted mode serves isolated synthetic workspaces and browser-selected local folders.
DEVSWEEP_HOSTED_DEMO=false
# Persistent root for individual synthetic demo sessions (mount a durable volume here).
DEVSWEEP_DEMO_ROOT=./data/demo-workspaces

# ============================================
# STORAGE & DATABASE
# ============================================
# SQLite database path for project manifests and history
DEVSWEEP_DB_PATH=./data/devsweep.db
# Optional. Defaults to the current user's application-data directory, outside scanned projects.
# Never set this inside a workspace that may be scanned or cleaned.
# DEVSWEEP_BACKUP_ROOT=C:/Users/<user>/AppData/Local/DevSweepAI/backups

# ============================================
# SAFETY SETTINGS
# ============================================
# Default risk level for auto-approval (SAFE, CAUTION, DANGEROUS)
DEVSWEEP_DEFAULT_RISK_LEVEL=SAFE

# Maximum file size to scan (bytes, default: 100MB)
DEVSWEEP_MAX_FILE_SIZE=104857600

# ============================================
# SERVER CONFIGURATION
# ============================================
# Keep loopback for local mode. Set 0.0.0.0 only with DEVSWEEP_HOSTED_DEMO=true.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated exact origins for a separately hosted frontend.
# Leave blank for same-origin deployment (recommended).
DEVSWEEP_CORS_ORIGINS=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
